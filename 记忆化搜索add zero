#include<bits/stdc++.h>
typedef long long ll;
using namespace std;

map<ll,vector<ll>>mp;
map<ll,bool>vis;
ll ans = 0;

void dfs(ll x){
	vis[x] = 1;
	ans = max(ans,x);
	for (auto &xx : mp[x]){
		if (vis[x+xx-1] == 0){
			dfs(x+xx-1);
		}
	}
}

int main(){
	int t;
	cin >> t;
	while (t--){
		int n;
		cin >> n;
		vis.clear() , mp.clear();
		ans = 0;
		vector<ll>nums(n+1,0);
		for (int i = 1 ; i <= n ; i++){
			cin >> nums[i];
			//nums[i] = nums.size() - i + 1;
			//i > 1
			//长度为x时可以触发的点，原来如此啊妙妙妙 
			if(i>1)mp[nums[i]+i-1].push_back(i);
		}
		dfs(n);
		cout << ans << endl;
	}	
	
	return 0;
}
